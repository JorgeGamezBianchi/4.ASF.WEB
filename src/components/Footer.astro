const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050b1a] text-slate-400 text-xs py-8 sm:py-10 border-t-2 border-cyan-500 mt-auto shadow-2xl">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center leading-relaxed space-y-4">
    <p class="text-slate-300 text-[11px] sm:text-xs max-w-3xl mx-auto">
      {currentYear}© Automation Solutions Factory S.A. de C.V., Todos los derechos reservados. | H. Ayuntamiento No. 4
      Col. San Juan Xocotla, Tultepec, Edo. México . C.P. 54960 Tel: 5378-2110
    </p>
    <div class="flex flex-wrap justify-center items-center gap-x-3 sm:gap-x-4 gap-y-2 text-[11px] text-slate-400">
      <a href="/" class="hover:text-cyan-400 py-1 transition">Inicio</a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a href="/nosotros" class="hover:text-cyan-400 py-1 transition">Quienes Somos</a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a href="/servicios" class="hover:text-cyan-400 py-1 transition">Servicios</a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a href="/clientes" class="hover:text-cyan-400 py-1 transition">Nuestros Clientes</a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a href="/contacto" class="hover:text-cyan-400 py-1 transition font-bold text-cyan-400">Contacto</a>
    </div>
  </div>
</footer>
