---
// ====================================================================================
// COMPONENTE ASTRO: src/components/ImagePlaceholder.astro
// ====================================================================================

interface Props {
  label: string;
  className?: string;
  width?: string;
  height?: string;
  note?: string;
  borderDashed?: boolean;
}

const {
  label,
  className = "",
  width = "w-full",
  height = "h-48",
  note = "",
  borderDashed = true,
} = Astro.props;
---

<div 
  class={`bg-[#0c1836] ${borderDashed ? 'border-2 border-dashed border-[#1f3466]' : 'border border-[#1f3466]'} rounded-lg flex flex-col items-center justify-center p-3 sm:p-4 text-center transition hover:border-cyan-400/80 hover:shadow-md hover:shadow-cyan-500/10 group select-none max-w-full ${width} ${height} ${className}`}
  title={label}
>
  <div class="w-10 h-10 rounded-full bg-[#081229] border border-[#233a70] flex items-center justify-center mb-2 text-slate-400 group-hover:text-cyan-400 group-hover:border-cyan-400 transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
      <circle cx="9" cy="9" r="2"/>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
    </svg>
  </div>
  <span class="text-xs font-semibold text-slate-300 group-hover:text-white tracking-wide uppercase px-2 line-clamp-1">{label}</span>
  {note && <span class="text-[11px] text-slate-400 mt-1 italic">{note}</span>}
  <span class="text-[10px] text-slate-500 mt-1 font-mono">[ Espacio en blanco ]</span>
</div>
