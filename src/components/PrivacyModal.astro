---
// ====================================================================================
// COMPONENTE: src/components/PrivacyModal.astro
// ====================================================================================
// Ventana emergente (modal) de Aviso de Privacidad.
// Se despliega de forma automática para nuevos visitantes de la web y persiste su
// confirmación en localStorage para no volver a interrumpir la navegación.
// ====================================================================================
---

<div 
  id="privacy-modal-overlay" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#030712]/80 backdrop-blur-sm transition-opacity duration-300 hidden opacity-0"
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="privacy-modal-title"
>
  <div 
    id="privacy-modal-card" 
    class="relative w-full max-w-lg bg-[#0a1532] border border-[#1e386e] rounded-xl shadow-2xl p-6 sm:p-8 text-slate-300 space-y-5 transform transition-all duration-300 scale-95"
  >
    <!-- Encabezado con Icono -->
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-xl bg-cyan-950/80 border border-cyan-400/40 text-cyan-400 flex items-center justify-center shrink-0 shadow-inner">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
      <div>
        <span class="inline-block px-2.5 py-0.5 bg-cyan-950/90 text-cyan-300 border border-cyan-400/30 text-[10px] font-bold uppercase tracking-wider rounded mb-1">
          Confidencialidad y Seguridad
        </span>
        <h2 id="privacy-modal-title" class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          Aviso de Privacidad
        </h2>
      </div>
    </div>

    <!-- Cuerpo del Aviso de Privacidad -->
    <div class="max-h-56 overflow-y-auto pr-2 space-y-3 text-xs leading-relaxed text-slate-300 border-y border-[#182d56] py-3.5 scrollbar-thin">
      <p>
        <strong class="text-white">Automation Solutions Factory S.A. de C.V. (Softlution!)</strong>,
        con domicilio en H. Ayuntamiento No. 4, Col. San Juan Xocotla, Tultepec, Estado de México, C.P. 54960, es responsable del tratamiento y protección de sus datos personales de conformidad con la legislación aplicable.
      </p>
      
      <p>
        Los datos personales que recabamos a través de nuestros formularios o canales de comunicación (tales como nombre, correo electrónico y número telefónico) son utilizados exclusivamente para:
      </p>

      <ul class="list-disc pl-5 space-y-1 text-slate-300 marker:text-cyan-400">
        <li>Atención y seguimiento a solicitudes de cotización de proyectos electromecánicos y de automatización.</li>
        <li>Provisión de servicios de soporte técnico, ingeniería y diagnóstico en planta.</li>
        <li>Establecimiento de comunicaciones comerciales y relaciones contractuales directas.</li>
      </ul>

      <p>
        Nos comprometemos a no transferir ni comercializar su información a terceros sin su consentimiento. Para dudas o ejercicio de sus derechos de acceso, rectificación, cancelación u oposición (ARCO), puede contactarnos en: <a href="mailto:contacto@softlution.com.mx" class="text-cyan-400 font-semibold hover:underline">contacto@softlution.com.mx</a>.
      </p>
    </div>

    <!-- Botones de Acción: Aceptar y Continuar -->
    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <button 
        id="btn-privacy-accept" 
        type="button" 
        class="flex-1 inline-flex items-center justify-center gap-2 bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-extrabold uppercase tracking-wider text-xs py-3 px-5 rounded-lg shadow-md shadow-cyan-400/25 transition duration-200 cursor-pointer transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>Aceptar</span>
      </button>

      <button 
        id="btn-privacy-continue" 
        type="button" 
        class="flex-1 inline-flex items-center justify-center gap-2 bg-[#0e1d44] hover:bg-[#122659] text-cyan-300 hover:text-white border border-[#1f376b] font-bold uppercase tracking-wider text-xs py-3 px-5 rounded-lg transition duration-200 cursor-pointer"
      >
        <span>Continuar</span>
      </button>
    </div>
  </div>
</div>

<script>
  // ====================================================================================
  // Control en el cliente: despliegue inicial y persistencia con localStorage
  // ====================================================================================
  const STORAGE_KEY = 'softlution_privacy_acknowledged';
  const overlay = document.getElementById('privacy-modal-overlay');
  const card = document.getElementById('privacy-modal-card');
  const btnAccept = document.getElementById('btn-privacy-accept');
  const btnContinue = document.getElementById('btn-privacy-continue');

  const showModal = () => {
    if (!overlay || !card) return;
    overlay.classList.remove('hidden');
    requestAnimationFrame(() => {
      overlay.classList.remove('opacity-0');
      overlay.classList.add('opacity-100');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    });
  };

  const closeModal = () => {
    if (!overlay || !card) return;
    try {
      localStorage.setItem(STORAGE_KEY, 'true');
    } catch {
      // Ignorar restricciones en entornos aislados
    }

    overlay.classList.remove('opacity-100');
    overlay.classList.add('opacity-0');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');

    setTimeout(() => {
      overlay.classList.add('hidden');
    }, 300);
  };

  // Verificar si ya fue confirmado en una visita previa
  try {
    const acknowledged = localStorage.getItem(STORAGE_KEY);
    if (!acknowledged) {
      showModal();
    }
  } catch {
    showModal();
  }

  btnAccept?.addEventListener('click', closeModal);
  btnContinue?.addEventListener('click', closeModal);
</script>
