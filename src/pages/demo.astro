---
// ====================================================================================
// PÁGINA: src/pages/demo.astro
// ====================================================================================

import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const modulosDemo = [
  {
    titulo: "1. Operación (Batch)",
    descripcion: "Módulo de control de bacheo, selección de recetas y arranque de reactores.",
    url: "http://softlution.com.mx/2%20-%20Batch-output/Web/2%20-%20Batch.html",
    enlaceTexto: "Abrir simulación de Operación →"
  },
  {
    titulo: "2. Validación y descarga",
    descripcion: "Verificación de parámetros de calidad y secuencia segura de descarga a tanques.",
    url: "http://softlution.com.mx/3%20-%20Validacion-output/Web/3%20-%20Validacion.html",
    enlaceTexto: "Abrir Validación y Descarga →"
  },
  {
    titulo: "3. Limpieza CIP",
    descripcion: "Ciclo automatizado de limpieza en sitio (Cleaning In Place) y enjuagues.",
    url: "http://softlution.com.mx/4%20-%20CIP-output/Web/4%20-%20CIP.html",
    enlaceTexto: "Abrir Ciclo CIP →"
  },
  {
    titulo: "4. Operación Simultánea",
    descripcion: "Gestión concurrente de múltiples reactores y líneas sin cuellos de botella.",
    url: "http://softlution.com.mx/5%20-%20Operacion%20Simultanea-output/Web/5%20-%20Operacion%20Simultanea.html",
    enlaceTexto: "Abrir Operación Simultánea →"
  },
  {
    titulo: "5. Reporte de Consumos",
    descripcion: "DataLogger para trazabilidad de materias primas, energía y tiempos de ciclo.",
    url: "http://softlution.com.mx/DataLogger-output/Web/DataLogger.html",
    enlaceTexto: "Abrir Reporte DataLogger →",
    colSpan: true
  }
];
---

<Layout 
  title="Softlution! – Demo | Automatización Industrial"
  description="Demostración y simulaciones interactivas del sistema automático de bacheo y lavado CIP en Diversey México."
>
  <PageBanner title="Demo" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <div class="bg-[#0b1736] border border-[#1c305c] p-6 sm:p-10 rounded-lg shadow-xl space-y-6 sm:space-y-8">
      
      <div class="text-center border-b border-[#1c305c] pb-6">
        <span class="inline-block px-3 py-1 bg-cyan-950/80 border border-cyan-400/40 text-cyan-300 text-xs font-bold uppercase tracking-wider rounded-full mb-3 shadow-xs">
          Simulación Interactiva
        </span>
        <h1 class="text-xl sm:text-3xl font-bold text-white">
          Sistema Automático de Bacheo Diversey-México
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Planta Tlalnepantla, Estado de México</p>
      </div>

      <div class="bg-[#071126] border border-[#1c305c] p-4 sm:p-6 rounded-lg">
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
          A continuación se muestran los módulos operativos correspondientes a la simulación y arquitectura del sistema de dosificación, bacheo y lavado CIP implementado para la planta de Diversey México:
        </p>

        <!-- Lista de Módulos Demo -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {modulosDemo.map((modulo) => (
            <div class={`bg-[#0b1736] border border-[#1c305c] p-5 rounded-lg hover:border-cyan-400 transition shadow-md flex flex-col justify-between ${modulo.colSpan ? 'sm:col-span-2 lg:col-span-1' : ''}`}>
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-bold text-sm text-white">{modulo.titulo}</span>
                  <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" x2="21" y1="14" y2="3"/>
                  </svg>
                </div>
                <p class="text-xs text-slate-400 mb-4">{modulo.descripcion}</p>
              </div>
              <a 
                href={modulo.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs text-cyan-400 font-bold hover:text-cyan-300 hover:underline inline-flex items-center gap-1"
              >
                {modulo.enlaceTexto}
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Banner Sistemas Permitidos -->
      <div class="mt-8 pt-6 border-t border-[#1c305c]">
        <ImagePlaceholder 
          label="Banner: Sistemas Permitidos (Sistemas-permitidos.png)" 
          height="h-28" 
          note="Software validado para entornos industriales"
        />
      </div>

    </div>
  </div>
</Layout>
