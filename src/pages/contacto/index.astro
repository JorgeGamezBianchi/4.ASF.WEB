---
// ====================================================================================
// PÁGINA UNIFICADA: src/pages/contacto/index.astro
// ====================================================================================

import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import ContactForm from '../../components/islands/ContactForm.jsx';
---

<Layout 
  title="Softlution! – Contacto | Automatización Industrial"
  description="Ponte en contacto con Automation Solutions Factory (Softlution) en Tultepec, Estado de México. Tel: 5378-2110. Ventas, cotizaciones y soporte técnico especializado."
>
  <PageBanner title="Contacto" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Encabezado de la Sección -->
    <div class="bg-[#0b1736] border border-[#1c305c] p-6 sm:p-8 rounded-lg shadow-xl mb-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 border-b border-[#1c305c] pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-cyan-950/80 border border-cyan-400/40 text-cyan-300 text-xs font-bold uppercase tracking-wider rounded-full mb-3 shadow-xs">
            Canal de Comunicación Directo
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white">
            Centro de Contacto Softlution<span class="text-cyan-400 font-extrabold">!</span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-2 max-w-2xl leading-relaxed">
            Estamos listos para colaborar en tus requerimientos de ingeniería, cotizaciones de proyectos, modernización de tableros industriales y soporte técnico especializado.
          </p>
        </div>
        <div class="shrink-0">
          <ImagePlaceholder 
            label="Logo ASF (ASF-LOGO.png)" 
            width="w-28 sm:w-36" 
            height="h-20 sm:h-24" 
            note="Softlution"
          />
        </div>
      </div>

      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mt-6">
        <span class="drop-cap text-cyan-400">N</span>uestro equipo profesional está a su entera disposición. No dude en comunicarse con nosotros si tiene alguna pregunta sobre nuestros servicios, solicitud de cotización o requerimiento de soporte técnico en planta. Puede enviarnos un mensaje a través del siguiente formulario, llamarnos a nuestra central o visitarnos previa cita.
      </p>
    </div>

    <!-- CUADRÍCULA PRINCIPAL: FORMULARIO + DATOS DE LA EMPRESA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- COLUMNA IZQUIERDA: FORMULARIO DE CONTACTO (7 COLS) -->
      <section class="lg:col-span-7 bg-[#0b1736] border border-[#1c305c] p-6 sm:p-8 rounded-lg shadow-xl space-y-6">
        <div class="border-b border-[#1c305c] pb-4">
          <h2 class="text-lg sm:text-xl font-bold text-white flex items-center">
            <span class="w-2 h-5 bg-cyan-400 inline-block mr-2.5 shrink-0 rounded-xs"></span>
            <span>Envíanos un Mensaje</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1 pl-4">
            Los campos marcados con (<span class="text-cyan-400">*</span>) son obligatorios.
          </p>
        </div>

        <!-- ISLA INTERACTIVA DE REACT -->
        <ContactForm client:load />
      </section>

      <!-- COLUMNA DERECHA: DATOS DE LA EMPRESA (5 COLS) -->
      <aside class="lg:col-span-5 space-y-6">
        
        <!-- Tarjeta de Información Corporativa -->
        <div class="bg-[#0b1736] border border-[#1c305c] p-6 rounded-lg shadow-xl space-y-6">
          <div class="border-b border-[#1c305c] pb-3">
            <h2 class="text-lg font-bold text-white flex items-center">
              <span class="w-2 h-5 bg-blue-500 inline-block mr-2.5 shrink-0 rounded-xs"></span>
              <span>Datos de la Empresa</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1 pl-4">
              Automation Solutions Factory S.A. de C.V.
            </p>
          </div>

          <!-- Dirección -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-cyan-950/80 border border-cyan-400/30 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="text-xs text-slate-300">
              <p class="font-bold text-white mb-0.5">Oficinas Principales</p>
              <p>H. Ayuntamiento No. 4</p>
              <p>Col. San Juan Xocotla, Tultepec</p>
              <p>Estado de México, C.P. 54960</p>
            </div>
          </div>

          <!-- Teléfono -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-blue-950/80 border border-blue-400/30 text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="text-xs text-slate-300">
              <p class="font-bold text-white mb-0.5">Central Telefónica</p>
              <a href="tel:53782110" class="text-base font-bold text-cyan-400 hover:text-cyan-300 hover:underline block">
                5378-2110
              </a>
              <p class="text-slate-400 mt-0.5">Lunes a Viernes: 8:00 a 18:00 hrs</p>
            </div>
          </div>

          <!-- Correos Electrónicos -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-cyan-950/80 border border-cyan-400/30 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="text-xs text-slate-300 space-y-1">
              <p class="font-bold text-white mb-0.5">Correos de Atención</p>
              <div>
                <span class="text-slate-400 block text-[11px]">Ventas y Cotizaciones:</span>
                <a href="mailto:ventas@softlution.com.mx" class="font-semibold text-slate-200 hover:text-cyan-400 transition">
                  ventas@softlution.com.mx
                </a>
              </div>
              <div class="pt-1">
                <span class="text-slate-400 block text-[11px]">Soporte Técnico:</span>
                <a href="mailto:soporte@softlution.com.mx" class="font-semibold text-slate-200 hover:text-cyan-400 transition">
                  soporte@softlution.com.mx
                </a>
              </div>
            </div>
          </div>

          <!-- Compromiso -->
          <div class="p-3.5 bg-[#071126] border border-[#1c305c] rounded text-xs text-slate-300 space-y-1">
            <p class="font-bold text-white flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Tiempo de Respuesta Garantizado
            </p>
            <p class="text-[11px] text-slate-400">
              Respondemos a todas las consultas técnicas y solicitudes de cotización en menos de 24 horas hábiles.
            </p>
          </div>
        </div>

        <!-- Tarjeta de Mapa / Ubicación Geográfica -->
        <div class="bg-[#0b1736] border border-[#1c305c] p-6 rounded-lg shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center justify-between">
            <span>Ubicación en el Mapa</span>
            <span class="text-xs font-normal text-slate-400">Tultepec, Edo. Mex</span>
          </h3>
          
          <div class="bg-[#071126] border border-[#1c305c] rounded h-48 flex flex-col items-center justify-center text-center p-4 text-slate-400 relative overflow-hidden">
            <svg class="w-8 h-8 text-cyan-400 mb-2 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <p class="font-bold text-xs text-white">Tultepec, Estado de México</p>
            <p class="text-[11px] text-slate-400 mt-0.5">H. Ayuntamiento No. 4, Col. San Juan Xocotla</p>
            
            <a 
              href="https://maps.google.com/?q=H.+Ayuntamiento+No.+4+San+Juan+Xocotla+Tultepec" 
              target="_blank" 
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1 text-[11px] font-bold text-cyan-400 hover:text-cyan-300 bg-[#0e1d44] hover:bg-[#122659] px-3 py-1.5 rounded border border-[#1f376b] transition"
            >
              <span>Ver en Google Maps</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

      </aside>

    </div>

    <!-- Banner Sistemas Permitidos -->
    <div class="mt-10 pt-6 border-t border-[#1c305c]">
      <ImagePlaceholder 
        label="Banner: Sistemas Permitidos (Sistemas-permitidos.png)" 
        height="h-24 sm:h-28" 
        note="Solvetic / Certificaciones y plataformas industriales"
      />
    </div>

  </div>
</Layout>
